# Base URL of the HelpDesk API.
#
# Leave it empty (the default) to use "/api":
#   - in development, Vite proxies /api to http://localhost:5000 (see vite.config.js)
#   - in production, the Express backend serves this build from the same origin
#
# Only set it when the API lives on a different origin, e.g.
#   VITE_API_URL=https://helpdesk-api.example.com/api
VITE_API_URL=
