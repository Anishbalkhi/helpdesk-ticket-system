{
  "name": "helpdesk-backend",
  "version": "1.0.0",
  "description": "REST API for the Support Ticket Management System (mini helpdesk)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.9.5",
    "morgan": "1.10.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "mongodb-memory-server": "10.1.3",
    "nodemon": "3.1.9",
    "supertest": "7.1.4"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.4"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 30000
  }
}
