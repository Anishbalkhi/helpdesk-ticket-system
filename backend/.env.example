# Copy to .env and adjust.
NODE_ENV=development
PORT=5000

# Local MongoDB, Docker (mongodb://mongo:27017/helpdesk) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/helpdesk

# Use a long random string in production, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Browser origins allowed to call the API (comma-separated). Not needed when the
# frontend is served by this server in production.
CLIENT_URL=http://localhost:5173

# Set to true to create the admin on server start (useful on hosts without a shell).
# SEED_DEMO=true also adds a demo user + sample tickets for reviewers.
SEED_ON_START=false
SEED_DEMO=false

# Admin account created by `npm run seed` / SEED_ON_START
# In production, ALWAYS set your own ADMIN_PASSWORD.
ADMIN_NAME=Support Admin
ADMIN_EMAIL=admin@helpdesk.dev
ADMIN_PASSWORD=Admin@12345
